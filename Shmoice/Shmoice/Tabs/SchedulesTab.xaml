<UserControl x:Class="Shmoice.Tabs.SchedulesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shmoice"
             xmlns:models="clr-namespace:Shmoice.Models"
             xmlns:tabs="clr-namespace:Shmoice.Tabs">
    <UserControl.Resources>
        <tabs:ScheduleKindLabel x:Key="KindLabel" />
        <x:Array x:Key="Kinds" Type="models:ScheduleKind">
            <models:ScheduleKind>AtTime</models:ScheduleKind>
            <models:ScheduleKind>Every</models:ScheduleKind>
        </x:Array>
        <!-- Day-of-week toggle (Mon, Tue …), filled with the accent color when on. -->
        <Style x:Key="Day" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" CornerRadius="6" Background="Transparent"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="Letter" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="Letter" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: the schedules -->
        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="6,2,0,8">
                    <TextBlock Text="SCHEDULES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="＋" Click="Add_Click" ToolTip="New schedule" Padding="10,2" Margin="0,0,4,0" />
                        <Button Content="🗑" Click="Remove_Click" ToolTip="Delete selected schedule" Padding="10,2" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ListEmpty" DockPanel.Dock="Top" Margin="8,4" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" Text="No schedules yet. Press ＋ to make one." />
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Schedule}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppAccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0" ToolTip="On" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Editor for the selected schedule -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <ScrollViewer x:Name="Editor" VerticalScrollBarVisibility="Auto" Visibility="Hidden">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="RUN THIS COMMAND" Style="{StaticResource SectionLabel}" />
                        <ComboBox x:Name="CommandCombo" Width="320" HorizontalAlignment="Left" Margin="0,0,0,18"
                                  DisplayMemberPath="Phrase" SelectedValuePath="Id" SelectedValue="{Binding CommandId}" />

                        <TextBlock Text="WHEN" Style="{StaticResource SectionLabel}" />
                        <ComboBox Width="160" HorizontalAlignment="Left" ItemsSource="{StaticResource Kinds}" SelectedItem="{Binding Kind}" Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource KindLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- At a time -->
                        <StackPanel x:Name="AtPanel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="80" MinWidth="0"
                                         TextAlignment="Center" MaxLength="5" ToolTip="24-hour time, e.g. 09:00 or 21:30" />
                                <TextBlock Text="24-hour time, e.g. 09:00 or 21:30" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <ToggleButton Content="Mon" IsChecked="{Binding Mon}" Style="{StaticResource Day}" />
                                <ToggleButton Content="Tue" IsChecked="{Binding Tue}" Style="{StaticResource Day}" />
                                <ToggleButton Content="Wed" IsChecked="{Binding Wed}" Style="{StaticResource Day}" />
                                <ToggleButton Content="Thu" IsChecked="{Binding Thu}" Style="{StaticResource Day}" />
                                <ToggleButton Content="Fri" IsChecked="{Binding Fri}" Style="{StaticResource Day}" />
                                <ToggleButton Content="Sat" IsChecked="{Binding Sat}" Style="{StaticResource Day}" />
                                <ToggleButton Content="Sun" IsChecked="{Binding Sun}" Style="{StaticResource Day}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Every N minutes -->
                        <StackPanel x:Name="EveryPanel" Orientation="Horizontal" Margin="0,0,0,18" Visibility="Collapsed">
                            <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" MinWidth="0"
                                     TextAlignment="Center" local:InputFilter.Kind="Integer" MaxLength="4" />
                            <TextBlock Text="minutes, counting from when Shmoice starts" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <CheckBox Content="Schedule is on" IsChecked="{Binding Enabled}" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,14" />
                        <Button Content="▶  Run it now" Click="RunNow_Click" HorizontalAlignment="Left" Padding="14,5" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0"
                                   Text="Schedules run while Shmoice is open (turn on Start with Windows in Settings so it always is). If the PC was asleep at the time, that run is skipped rather than done late." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EditorEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="Run commands automatically" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                               Text="Schedules run a command without you saying anything: at a time on chosen days, like “open my work apps” at 09:00 on weekdays, or every so many minutes, like a stretch reminder every hour. Press ＋ to add one." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
