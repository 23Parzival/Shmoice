<UserControl x:Class="Shmoice.Tabs.ProfilesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Profile list -->
        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="6,2,0,8">
                    <TextBlock Text="PROFILES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="＋" Click="Add_Click" ToolTip="New profile" Padding="10,2" Margin="0,0,4,0" />
                        <Button Content="🗑" Click="Delete_Click" ToolTip="Delete selected profile" Padding="10,2" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ListEmpty" DockPanel.Dock="Top" Margin="8,4" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="No profiles yet. Press ＋ to make one, e.g. “Gaming” for your game." />
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Apps}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0" ToolTip="On" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Profile editor -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <ScrollViewer x:Name="Editor" VerticalScrollBarVisibility="Auto" Visibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="NAME" Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,0,0,16" MaxWidth="420" HorizontalAlignment="Left" Width="420" />

                        <TextBlock Text="ACTIVE WHILE ONE OF THESE APPS IS IN FRONT" Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding Apps, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" Width="420" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <ComboBox x:Name="RunningApps" Width="220" DropDownOpened="RunningApps_DropDownOpened"
                                      SelectionChanged="RunningApps_SelectionChanged" />
                            <TextBlock Text="← add an app that's open right now" VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="App names, separated by commas, e.g. “chrome, firefox”. Tip: open the app first, then pick it from the list above." />

                        <CheckBox Content="Profile is on" IsChecked="{Binding Enabled}" Margin="0,0,0,20" />

                        <TextBlock Text="COMMANDS IN THIS PROFILE" Style="{StaticResource SectionLabel}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Ticked commands only run while one of the apps above is in front. A command can be in one profile at a time; you can also choose this in the command editor (Runs in)." />
                        <ItemsControl x:Name="CommandChecks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding InProfile, Mode=OneWay}" Click="CommandCheck_Click" Margin="0,0,0,4">
                                        <TextBlock>
                                            <Run Text="{Binding Phrase, Mode=OneWay, StringFormat='“{0}”'}" />
                                            <Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EditorEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="Commands for specific apps" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                               Text="A profile is a set of commands that only run while a certain app is in front. That means fewer accidental triggers, and the same phrase can do different things in different apps, like “reload” in a game and in your browser." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
