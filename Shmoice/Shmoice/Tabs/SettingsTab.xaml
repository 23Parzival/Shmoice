<UserControl x:Class="Shmoice.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shmoice">
    <!-- DataContext is the app's AppData (inherited from the main window). Every change saves on its own. -->
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <!-- Theme choice: a small picture of the theme; the chosen one gets an accent outline. -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="10" Padding="10" BorderThickness="2"
                                BorderBrush="Transparent" Background="{DynamicResource RowBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Accent swatch: a colored circle with a ring around the chosen one. -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="40" Height="40" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Visibility="Hidden" />
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: sections -->
        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SETTINGS" Style="{StaticResource SectionLabel}" Margin="6,2,0,8" />
                <ListBox x:Name="Sections" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         SelectedIndex="0" SelectionChanged="Sections_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="🎙  Listening" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Wake word, microphone, confidence, chime" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="🎨  Appearance" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Dark or light mode, accent color" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="🚀  Startup" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Start with Windows, minimized, logo" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="⚙  Commands" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Delete confirmation, AI key" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="ℹ  About" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Version and where your data is" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The selected section -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
            <Grid>
                <!-- Listening -->
                <ScrollViewer x:Name="ListeningSection" Style="{StaticResource Section}" Visibility="Visible">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Listening" Style="{StaticResource Title}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Wake word" VerticalAlignment="Top" Margin="0,7,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding Settings.WakeWord, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"
                                         local:InputFilter.Kind="Words" MaxLength="30" />
                                <TextBlock Style="{StaticResource Hint}" Text="Say this before every command, e.g. “computer volume up”. Pick a word you don't say by accident." />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Microphone" VerticalAlignment="Top" Margin="0,7,0,0" />
                            <StackPanel Grid.Column="1">
                                <Button x:Name="MicButton" Click="Mic_Click" HorizontalAlignment="Left" Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎙" Margin="0,0,8,0" />
                                        <TextBlock x:Name="MicText" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="▾" Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Hint}" Text="Same as the microphone button at the top right. The picker has a level meter to check it hears you." />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Min confidence" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Slider Value="{Binding Settings.ConfidenceThreshold}" Minimum="0.3" Maximum="0.95" Width="240"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Settings.ConfidenceThreshold, StringFormat={}{0:P0}}" Margin="12,0,0,0"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Higher means fewer accidental triggers, but you may need to speak more clearly. The Voice test tab shows how sure it is when you talk." />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Chime volume" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="ChimeSlider" Value="{Binding Settings.ChimeVolume}" Minimum="0" Maximum="1" Width="240"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonUp="Chime_Released" KeyUp="Chime_Released" />
                                    <TextBlock Text="{Binding Settings.ChimeVolume, StringFormat={}{0:P0}}" Margin="12,0,0,0"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="The chime plays when a Listen for words step starts. Let go of the slider to hear it. All the way left turns it off." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Appearance -->
                <ScrollViewer x:Name="AppearanceSection" Style="{StaticResource Section}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Appearance" Style="{StaticResource Title}" />

                        <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Tag="Dark" Checked="Theme_Checked" Style="{StaticResource ThemeCard}">
                                <StackPanel>
                                    <Border Width="96" Height="56" CornerRadius="6" Background="#16161C" BorderBrush="#2E2E3A" BorderThickness="1">
                                        <StackPanel Margin="8">
                                            <Border Height="8" Width="50" CornerRadius="4" Background="#3A3A48" HorizontalAlignment="Left" />
                                            <Border Height="8" Width="70" CornerRadius="4" Background="#2E2E3A" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Dark" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Tag="Light" Checked="Theme_Checked" Style="{StaticResource ThemeCard}">
                                <StackPanel>
                                    <Border Width="96" Height="56" CornerRadius="6" Background="#F3F3F7" BorderBrush="#DFDFE7" BorderThickness="1">
                                        <StackPanel Margin="8">
                                            <Border Height="8" Width="50" CornerRadius="4" Background="#C9C9D3" HorizontalAlignment="Left" />
                                            <Border Height="8" Width="70" CornerRadius="4" Background="#DFDFE7" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Light" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Tag="System" Checked="Theme_Checked" Style="{StaticResource ThemeCard}">
                                <StackPanel>
                                    <Grid Width="96" Height="56">
                                        <Border CornerRadius="6" Background="#F3F3F7" BorderBrush="#DFDFE7" BorderThickness="1" />
                                        <Border CornerRadius="0,6,6,0" Background="#16161C" Width="48" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="Match Windows" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="Accent color" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="Swatches" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Custom" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="CustomHex" Width="110" MaxLength="7" KeyDown="CustomHex_KeyDown" LostFocus="CustomHex_LostFocus"
                                     ToolTip="Any color as #RRGGBB, e.g. #FF5599" />
                            <Ellipse x:Name="CustomPreview" Width="22" Height="22" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CustomHint" Style="{StaticResource Hint}" Text="Type a color like #FF5599 and press Enter." Margin="0,0,0,24" />

                        <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Border Background="{DynamicResource RowBrush}" CornerRadius="8" Padding="16,12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="A checkbox" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center" />
                                <Slider Width="140" Value="0.6" Maximum="1" VerticalAlignment="Center" Margin="0,0,24,0" />
                                <Border CornerRadius="10" Padding="10,3" Background="{DynamicResource AppAccentBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="Selected" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Startup -->
                <ScrollViewer x:Name="StartupSection" Style="{StaticResource Section}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Startup" Style="{StaticResource Title}" />
                        <CheckBox x:Name="StartWithWindows" Content="Start Shmoice when I sign in to Windows" Click="StartWithWindows_Click" />
                        <TextBlock Style="{StaticResource Hint}" Margin="30,2,0,14" Text="So your commands and schedules are always ready." />
                        <CheckBox Content="Start minimized" IsChecked="{Binding Settings.StartMinimized}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="30,2,0,14" Text="Opens in the taskbar instead of on screen. Handy with Start with Windows." />
                        <CheckBox Content="Show the logo for a moment when Shmoice starts" IsChecked="{Binding Settings.ShowSplash}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="30,2,0,0" Text="Not shown when starting minimized." />
                    </StackPanel>
                </ScrollViewer>

                <!-- Commands -->
                <ScrollViewer x:Name="CommandsSection" Style="{StaticResource Section}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Commands" Style="{StaticResource Title}" />
                        <CheckBox Content="Ask before deleting a command" IsChecked="{Binding Settings.ConfirmDelete}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="30,2,0,18" Text="You can also undo a delete with the ‹ back button." />
                        <TextBlock Text="AI Builder key" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Text="Your Anthropic API key is set in the AI Builder tab. It's stored encrypted for your Windows account." />
                    </StackPanel>
                </ScrollViewer>

                <!-- About -->
                <ScrollViewer x:Name="AboutSection" Style="{StaticResource Section}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="About" Style="{StaticResource Title}" />
                        <TextBlock x:Name="VersionText" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Style="{StaticResource Hint}" Text="Say it. Your PC does it." Margin="0,2,0,18" />
                        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox Content="Check for updates automatically" IsChecked="{Binding Settings.CheckForUpdates}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="30,2,0,10"
                                   Text="Looks on GitHub when Shmoice starts and a few times a day. When there's a new version, an update button appears at the top; nothing installs until you press it." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckUpdates_Click" Padding="12,4" />
                            <Button x:Name="InstallUpdateButton" Content="Install update" Click="InstallUpdate_Click" Padding="12,4" Margin="8,0,0,0"
                                    Style="{StaticResource AccentButton}" Visibility="Collapsed" />
                            <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="460"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="Your data" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Text="Commands, profiles, schedules, settings and history are saved in this folder. Uninstalling Shmoice keeps them." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="DataFolderText" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" />
                            <Button Content="Open folder" Click="OpenFolder_Click" Padding="12,4" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
