<UserControl x:Class="Shmoice.Tabs.VoiceTestTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Left: mic level, practice mode, what was heard -->
        <Border Style="{StaticResource Card}" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MICROPHONE" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="MicName" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ProgressBar x:Name="LevelBar" Height="10" Minimum="0" Maximum="1" Style="{StaticResource Meter}" />
                    <TextBlock x:Name="LevelHint" Margin="0,6,0,16" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                               Text="Say something. The bar should move while you talk." />

                    <TextBlock Text="PRACTICE" Style="{StaticResource SectionLabel}" />
                    <CheckBox x:Name="PracticeCheck" Content="Practice mode: show what Shmoice hears without running anything"
                              Click="Practice_Click" />
                    <TextBlock x:Name="PracticeHint" Margin="0,6,0,16" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />

                    <Grid>
                        <TextBlock Text="WHAT SHMOICE HEARD" Style="{StaticResource SectionLabel}" />
                        <Button Content="Clear" Click="ClearFeed_Click" HorizontalAlignment="Right" Padding="10,1" FontSize="11" />
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="FeedEmpty" DockPanel.Dock="Top" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Say your wake word and a command. Each thing Shmoice recognizes shows up here with how sure it was. If nothing appears, it didn't match any of your commands." />
                <ListBox x:Name="Feed" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Phrase, StringFormat='“{0}”'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Outcome}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <ProgressBar Value="{Binding Confidence, Mode=OneWay}" Maximum="1" Height="6"
                                                 Style="{StaticResource Meter}" Foreground="{DynamicResource AppAccentBrush}" />
                                    <TextBlock Text="{Binding Confidence, StringFormat={}{0:P0} sure}" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: phrases that sound alike, tips -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock Text="TIPS FOR BETTER RECOGNITION" Style="{StaticResource SectionLabel}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" LineHeight="18">
                        • Two or three words beat one: “next song” is safer than “next”.<LineBreak />
                        • Avoid phrases that rhyme or differ by one sound.<LineBreak />
                        • Speak at a normal pace; pausing between the wake word and the command is fine.<LineBreak />
                        • If good commands get ignored, lower Min confidence in Settings a little.
                    </TextBlock>
                </StackPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Text="PHRASES THAT SOUND ALIKE" Style="{StaticResource SectionLabel}" />
                    <Button Content="Check again" Click="CheckPhrases_Click" HorizontalAlignment="Right" Padding="10,1" FontSize="11" />
                </Grid>
                <TextBlock x:Name="SimilarEmpty" DockPanel.Dock="Top" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <ItemsControl x:Name="SimilarList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource RowBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                        <Run Text="{Binding A, Mode=OneWay, StringFormat='“{0}”'}" /> and <Run Text="{Binding B, Mode=OneWay, StringFormat='“{0}”'}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
