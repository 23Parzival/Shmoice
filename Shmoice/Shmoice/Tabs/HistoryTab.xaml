<UserControl x:Class="Shmoice.Tabs.HistoryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:Shmoice.Tabs">
    <UserControl.Resources>
        <tabs:HistoryFormat x:Key="Format" />
        <!-- Sidebar filter row: label on the left, count on the right. -->
        <Style x:Key="FilterItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- Compact rows so the filters and the most-used list all fit. -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: search, filters, most used, clear -->
        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Clear history" Click="Clear_Click" HorizontalAlignment="Stretch" Margin="6,8,6,4" Padding="12,5" />

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="HISTORY" Style="{StaticResource SectionLabel}" Margin="6,2,0,8" />
                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" />
                        <TextBlock x:Name="SearchHint" Text="Search history…" IsHitTestVisible="False" Margin="12,0"
                                   VerticalAlignment="Center" FontStyle="Italic" Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>

                    <TextBlock Text="SHOW" Style="{StaticResource SectionLabel}" Margin="6,0,0,4" />
                    <ListBox x:Name="ResultFilter" Background="Transparent" BorderThickness="0" SelectedIndex="0"
                             SelectionChanged="Filter_Changed" ItemContainerStyle="{StaticResource FilterItem}" Margin="0,0,0,12">
                        <ListBoxItem><Grid><TextBlock Text="Everything" /><TextBlock x:Name="CountAll" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" /></Grid></ListBoxItem>
                        <ListBoxItem><Grid><TextBlock Text="Ran" /><TextBlock x:Name="CountRan" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" /></Grid></ListBoxItem>
                        <ListBoxItem><Grid><TextBlock Text="Failed" /><TextBlock x:Name="CountFailed" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" /></Grid></ListBoxItem>
                        <ListBoxItem><Grid><TextBlock Text="Ignored or skipped" /><TextBlock x:Name="CountIgnored" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" /></Grid></ListBoxItem>
                    </ListBox>

                    <TextBlock Text="HOW IT RAN" Style="{StaticResource SectionLabel}" Margin="6,0,0,4" />
                    <ListBox x:Name="SourceFilter" Background="Transparent" BorderThickness="0" SelectedIndex="0"
                             SelectionChanged="Filter_Changed" ItemContainerStyle="{StaticResource FilterItem}" Margin="0,0,0,12">
                        <ListBoxItem Content="Any way" />
                        <ListBoxItem Content="By voice" />
                        <ListBoxItem Content="By schedule" />
                        <ListBoxItem Content="By hand (Test, Run again)" />
                    </ListBox>

                    <TextBlock Text="MOST USED BY VOICE" Style="{StaticResource SectionLabel}" Margin="6,0,0,4" />
                    <TextBlock x:Name="MostUsedEmpty" Text="Nothing yet." Margin="6,2" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <!-- Click one to show only that command. -->
                <ListBox x:Name="MostUsed" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource FilterItem}"
                         SelectionChanged="MostUsed_SelectionChanged" ToolTip="Click to show only this command">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Phrase, StringFormat='“{0}”'}" TextTrimming="CharacterEllipsis" Margin="0,0,40,0" />
                                <TextBlock Text="{Binding Count, StringFormat=×{0}}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The history itself -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Converter={StaticResource Format}, ConverterParameter=When}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <Border Grid.Column="1" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding Converter={StaticResource Format}, ConverterParameter=Badge}">
                                    <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Phrase, Mode=OneWay, StringFormat='“{0}”'}" />
                                        <Run Text="{Binding Converter={StaticResource Format}, ConverterParameter=Source, Mode=OneWay}"
                                             FontWeight="Normal" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Converter={StaticResource Format}, ConverterParameter=Detail}" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding Converter={StaticResource Format}, ConverterParameter=DetailVisibility}" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="▶  Run again" Click="RunAgain_Click" Padding="10,3" VerticalAlignment="Center"
                                        ToolTip="Run this command now" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Margin="4,6" VerticalAlignment="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="Nothing yet. Commands you run show up here, by voice, by schedule, or with Test." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
