<Window x:Class="Shmoice.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shmoice" Icon="/Assets/Shmoice.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        Width="380" Height="420">
    <!-- Logo card that fades and grows in, with a thin bar that fills while it's shown. -->
    <Border x:Name="Card" Margin="20" CornerRadius="22" Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.92" ScaleY="0.92" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Image Source="/Assets/Logo.png" Width="190" Height="190" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Shmoice" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,2" />
                <TextBlock Text="Say it. Your PC does it." Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <Border VerticalAlignment="Bottom" Height="3" Margin="60,0,60,26" CornerRadius="1.5"
                    Background="{DynamicResource CardBorderBrush}">
                <Border x:Name="Progress" HorizontalAlignment="Left" Width="0" CornerRadius="1.5" Background="#0B7F8A" />
            </Border>
        </Grid>
    </Border>
</Window>
