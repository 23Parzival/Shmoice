<Window x:Class="Shmoice.MainWindow"
        Icon="/Assets/Shmoice.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:models="clr-namespace:Shmoice.Models"
        xmlns:local="clr-namespace:Shmoice"
        xmlns:tabs="clr-namespace:Shmoice.Tabs"
        Title="Shmoice" Height="900" Width="1320" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}" FontSize="13">
    <Window.Resources>
        <local:ActionLabelConverter x:Key="ActionLabel" />
        <local:ProfileNameConverter x:Key="ProfileName" />
        <local:NullGuidConverter x:Key="NullGuid" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Column header shared by both step lists. Widths match StepRow below. -->
        <Grid x:Key="StepHeaderTemplate" x:Shared="False" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ACTION" Style="{StaticResource SectionLabel}" Margin="0" />
            <TextBlock Grid.Column="2" Text="PARAMETER" Style="{StaticResource SectionLabel}" Margin="0" />
            <TextBlock Grid.Column="4" Text="REPEAT" Style="{StaticResource SectionLabel}" Margin="0" Width="128" TextAlignment="Center" />
            <Border Grid.Column="6" Width="84" />
        </Grid>

        <!-- One step = one row of real (theme-styled) controls, always editable. -->
        <DataTemplate x:Key="StepRow" DataType="{x:Type models:ActionStep}">
            <Border Background="{DynamicResource RowBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Opens a searchable tree of actions grouped by category. -->
                    <local:ActionPicker Grid.Column="0" SelectedType="{Binding Type}" VerticalAlignment="Center" />

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- The tooltip shows the whole parameter: web requests and scripts are often wider than the box. -->
                        <TextBox x:Name="ParamBox" Text="{Binding Parameter, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NeedsParameter}"
                                 ToolTip="{Binding ParameterTip}" />
                        <!-- "Press keys" records the keys you press instead of typing them. -->
                        <local:KeyRecorder x:Name="KeyBox" Combo="{Binding Parameter, Mode=TwoWay}" Visibility="Collapsed" />
                        <TextBlock x:Name="Hint" Text="{Binding ParameterHint}" IsHitTestVisible="False" Visibility="Collapsed"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="12,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontStyle="Italic" />
                    </Grid>

                    <!-- Repeat stepper -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="−" Click="RepeatDown_Click" Width="34" Padding="0,4" FontSize="15" ToolTip="Fewer times" />
                        <TextBox Text="{Binding Repeat, UpdateSourceTrigger=PropertyChanged}" Width="52" MinWidth="0" Margin="4,0"
                                 local:InputFilter.Kind="Integer" MaxLength="3"
                                 TextAlignment="Center" FontSize="15" FontWeight="Bold" Padding="2,5"
                                 Foreground="{DynamicResource AppAccentBrush}" ToolTip="How many times to run this step" />
                        <Button Content="+" Click="RepeatUp_Click" Width="34" Padding="0,4" FontSize="15" ToolTip="More times" />
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↑" Click="MoveStepUp_Click" Width="38" Padding="0,4" Margin="0,0,6,0" ToolTip="Move up" />
                        <Button Content="✕" Click="RemoveStep_Click" Width="38" Padding="0,4" ToolTip="Remove step" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Parameter}" Value="">
                    <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Listed last so it wins over the hint trigger above. -->
                <DataTrigger Binding="{Binding ParameterKind}" Value="{x:Static models:ParamKind.Keys}">
                    <Setter TargetName="ParamBox" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="KeyBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Number-only parameters (Wait seconds, Set volume percent). -->
                <DataTrigger Binding="{Binding ParameterKind}" Value="{x:Static models:ParamKind.Decimal}">
                    <Setter TargetName="ParamBox" Property="local:InputFilter.Kind" Value="Decimal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ParameterKind}" Value="{x:Static models:ParamKind.Integer}">
                    <Setter TargetName="ParamBox" Property="local:InputFilter.Kind" Value="Integer" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Dashed "add step" row that sits right under the last step. -->
        <Style x:Key="DashedAddButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Outline" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                                       Stroke="{DynamicResource CardBorderBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The whole steps area for a command: fills all available height, header on top,
             steps scroll, and the add row follows the last step. DataContext = VoiceCommand. -->
        <DataTemplate x:Key="StepsPanel" DataType="{x:Type models:VoiceCommand}">
            <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="10,10,10,4">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{StaticResource StepHeaderTemplate}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepRow}" />
                            <Button Style="{StaticResource DashedAddButton}" Click="AddStepInline_Click" Margin="0,0,0,6">
                                <TextBlock Text="＋  Add a step" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Right-click menu for a command in the list. DataContext = the VoiceCommand. -->
        <ContextMenu x:Key="CommandMenu" x:Shared="False" Opened="CommandMenu_Opened">
            <MenuItem Header="Test now" Click="MenuTest_Click">
                <MenuItem.Icon><TextBlock Text="▶" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Rename" Click="MenuRename_Click">
                <MenuItem.Icon><TextBlock Text="✏" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplicate" Click="MenuDuplicate_Click">
                <MenuItem.Icon><TextBlock Text="⧉" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Enabled" IsCheckable="True" IsChecked="{Binding Enabled}" />
            <Separator />
            <MenuItem Header="Move to top" Click="MenuMoveTop_Click" />
            <MenuItem Header="Move to bottom" Click="MenuMoveBottom_Click" />
            <Separator />
            <MenuItem Tag="AskBeforeDelete" Header="Ask before deleting" IsCheckable="True"
                      Click="MenuAskBeforeDelete_Click" />
            <MenuItem Header="Delete" Click="MenuDelete_Click" Foreground="#FF6B7A" InputGestureText="Del">
                <MenuItem.Icon><TextBlock Text="🗑" Foreground="#FF6B7A" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- The ‹ › arrows on the back / forward buttons, drawn so they sit exactly in the middle. Dim while the button is off. -->
        <Style x:Key="NavChevron" TargetType="Path">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{DynamicResource BodyTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Invisible drag area with a small visible grip; highlights on hover. -->
        <Style x:Key="VSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="4" Height="40" CornerRadius="2"
                                    Background="{DynamicResource CardBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HSplitter" TargetType="GridSplitter" BasedOn="{StaticResource VSplitter}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="14" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="40" Height="4" CornerRadius="2"
                                    Background="{DynamicResource CardBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />                 <!-- header -->
            <RowDefinition Height="Auto" />                 <!-- (unused; settings now sit in the tab row) -->
            <RowDefinition Height="*" MinHeight="220" />    <!-- tabs -->
            <RowDefinition Height="Auto" />                 <!-- splitter -->
            <RowDefinition Height="140" MinHeight="60" />   <!-- activity -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Shmoice" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Say it. Your PC does it." Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Only shown once a newer version has been found on GitHub. -->
                <Button x:Name="UpdateButton" Click="UpdateButton_Click" Style="{StaticResource AccentButton}" Padding="14,8"
                        Margin="0,0,12,0" FontWeight="SemiBold" Visibility="Collapsed" />
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource IdleBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="Not listening" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="MicButton" Click="MicButton_Click" Padding="14,8"
                        ToolTip="Choose which microphone Shmoice listens to">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎙" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="MicButtonText" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="▾" Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Main tabs ===== -->
        <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Commands">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- Command list -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="6,2,0,8">
                                <TextBlock Text="YOUR COMMANDS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="＋" Click="AddCommand_Click" ToolTip="New command" Padding="10,2" Margin="0,0,4,0" />
                                    <Button Content="🗑" Click="DeleteCommand_Click" ToolTip="Delete selected command" Padding="10,2" />
                                </StackPanel>
                            </Grid>
                            <!-- Filters by phrase and by what the steps do (e.g. "volume", "spotify"). -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="CommandSearch" TextChanged="CommandSearch_TextChanged" KeyDown="CommandSearch_KeyDown"
                                         ToolTip="Search by phrase or by what the command does" />
                                <TextBlock x:Name="CommandSearchHint" Text="Search commands…" IsHitTestVisible="False" Margin="12,0"
                                           VerticalAlignment="Center" FontStyle="Italic" Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                            <TextBlock x:Name="NoCommandMatches" DockPanel.Dock="Top" Text="No commands match." Margin="8,4"
                                       Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed" />
                            <ListBox x:Name="CommandList" ItemsSource="{Binding Commands}" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="CommandList_SelectionChanged" KeyDown="CommandList_KeyDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="ContextMenu" Value="{StaticResource CommandMenu}" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="CommandItem_RightMouseDown" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Phrase, StringFormat='“{0}”'}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Steps.Count, Mode=OneWay, StringFormat={}{0} step(s)}" /><Run
                                                         Text="{Binding ProfileId, Mode=OneWay, Converter={StaticResource ProfileName}}"
                                                         Foreground="{DynamicResource AppAccentBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                      ToolTip="Enabled" MinWidth="0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Style="{StaticResource VSplitter}" />

                    <!-- Command editor -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                        <Grid>
                            <DockPanel x:Name="Editor" DataContext="{Binding SelectedItem, ElementName=CommandList}">
                                <StackPanel DockPanel.Dock="Top">
                                    <!-- Label on the left, profile picker on the right of the same row, to leave more height for the steps. -->
                                    <Grid Margin="0,0,0,6">
                                        <!-- "WHEN I SAY “computer” ✎", then the phrase box below: the wake word is a link that opens a small box to change it.
                                             The editor's DataContext is the command, so this panel points back at the app settings. -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    DataContext="{Binding DataContext.Settings, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Text="WHEN I SAY" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="WakeWordToggle" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand" Focusable="False"
                                                          ToolTip="The wake word you say before every command. Click to change it.">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                                            <TextBlock x:Name="Word" Style="{StaticResource SectionLabel}" Margin="0"
                                                                       Foreground="{DynamicResource AppAccentBrush}"
                                                                       Text="{Binding WakeWord, StringFormat='“{0}”'}" />
                                                            <TextBlock x:Name="Pencil" Text="✎" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Word" Property="TextDecorations" Value="Underline" />
                                                                <Setter TargetName="Pencil" Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Popup x:Name="WakeWordPopup" PlacementTarget="{Binding ElementName=WakeWordToggle}" Placement="Bottom"
                                                   VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                                   IsOpen="{Binding IsChecked, ElementName=WakeWordToggle, Mode=TwoWay}"
                                                   Opened="WakeWordPopup_Opened" Closed="WakeWordPopup_Closed">
                                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="14,12" Width="300">
                                                    <StackPanel>
                                                        <TextBlock Text="WAKE WORD" Style="{StaticResource SectionLabel}" />
                                                        <TextBox x:Name="WakeWordBox" Text="{Binding WakeWord, UpdateSourceTrigger=PropertyChanged}"
                                                                 local:InputFilter.Kind="Words" MaxLength="30" KeyDown="WakeWordBox_KeyDown" />
                                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Text="Said before every command, for all your commands. Pick a word you don't say by accident." />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                        <!-- Profiles: limit this command to certain apps. -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Runs in" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,0" />
                                            <ComboBox x:Name="ProfileCombo" Width="220" SelectedValuePath="Id" DisplayMemberPath="Name"
                                                      SelectedValue="{Binding ProfileId, Converter={StaticResource NullGuid}}"
                                                      ToolTip="Any app, or only while the apps of a profile are in front (set up in the Profiles tab)" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="PhraseBox" Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,0,0,14" />
                                    <TextBlock Text="DO THESE STEPS, IN ORDER" Style="{StaticResource SectionLabel}" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom">
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="▶  Test" Click="TestCommand_Click" Margin="0,0,6,6" />
                                        <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}"
                                                Padding="20,5" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <!-- Quick tips for the steps whose parameter isn't obvious; sits beside Save and opens below. -->
                                    <!-- Plain text toggle: no box, no animation. -->
                                    <ToggleButton x:Name="TipsToggle" Margin="16,0,0,6" VerticalAlignment="Center" Cursor="Hand"
                                                  Focusable="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                    <TextBlock x:Name="Arrow" Text="▸" Width="12" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Label" Text="TIPS" Style="{StaticResource SectionLabel}" Margin="0" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Text" Value="▾" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Label" Property="Foreground" Value="White" />
                                                        <Setter TargetName="Arrow" Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    </WrapPanel>
                                    <StackPanel TextBlock.Foreground="{DynamicResource MutedTextBrush}" TextBlock.FontSize="11.5"
                                                Margin="0,4,0,0"
                                                Visibility="{Binding IsChecked, ElementName=TipsToggle, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                            • <Run FontWeight="SemiBold">Press keys:</Run> click the box, then press the key or
                                            combo you want, like Alt+Z or Win+D. Press Esc to cancel.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                            • <Run FontWeight="SemiBold">Open:</Run> to pass extra options to a program, put them after a |, like
                                            <Run FontFamily="Cascadia Mono, Consolas">notepad.exe | C:\notes.txt</Run>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                            • <Run FontWeight="SemiBold">Volume up / down:</Run> each step changes the volume by 2%.
                                            Set Repeat to 5 for a 10% change. To jump to an exact level, use Set volume.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                            • <Run FontWeight="SemiBold">Switch to / Close app:</Run> type part of the app's name or
                                            window title, like <Run FontFamily="Cascadia Mono, Consolas">chrome</Run> or
                                            <Run FontFamily="Cascadia Mono, Consolas">spotify</Run>. The app must already be open.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                            • <Run FontWeight="SemiBold">Mouse:</Run> clicks happen wherever the pointer is. Each scroll
                                            step is one notch of the wheel. Screenshots go to Pictures\Screenshots.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                            • <Run FontWeight="SemiBold">Listen for words:</Run> after the chime, say anything. Later
                                            steps can use it by writing <Run FontFamily="Cascadia Mono, Consolas">{heard}</Run>, like
                                            Search YouTube → <Run FontFamily="Cascadia Mono, Consolas">{heard}</Run> or
                                            Type text → <Run FontFamily="Cascadia Mono, Consolas">Note: {heard}</Run>.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                            • <Run FontWeight="SemiBold">Advanced:</Run> Send web request is written
                                            <Run FontFamily="Cascadia Mono, Consolas">POST https://… | Header: value | body</Run>. Its reply, a
                                            script's output or an AI's answer is the <Run FontFamily="Cascadia Mono, Consolas">{result}</Run>
                                            for later steps. You can also write <Run FontFamily="Cascadia Mono, Consolas">{clipboard}</Run>,
                                            <Run FontFamily="Cascadia Mono, Consolas">{date}</Run>, <Run FontFamily="Cascadia Mono, Consolas">{time}</Run>
                                            and <Run FontFamily="Cascadia Mono, Consolas">{app}</Run>. More in the Help tab.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap">
                                            • <Run FontWeight="SemiBold">Finding an action:</Run> open the action list and type to search,
                                            like <Run FontFamily="Cascadia Mono, Consolas">tab</Run> or
                                            <Run FontFamily="Cascadia Mono, Consolas">mute</Run>. Hover an action to see what it does.
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepsPanel}"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" />
                            </DockPanel>

                            <!-- Empty state -->
                            <TextBlock x:Name="EmptyState" Text="Select a command, or click ＋ to make a new one."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="✨ AI Builder">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" MinWidth="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- Describe + API key -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <!-- Which AI is used (bottom); it's chosen in Settings → AI. -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <TextBlock Text="AI SERVICE" Style="{StaticResource SectionLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Change" Click="AiSettings_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="Choose the AI service, model and key in Settings" />
                                    <TextBlock x:Name="AiProviderStatus" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock x:Name="AiProviderHint" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Describe (top) -->
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="DESCRIBE WHAT YOU WANT" Style="{StaticResource SectionLabel}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button x:Name="GenerateButton" Content="✨  Generate command" Click="Generate_Click"
                                        Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch"
                                        Padding="0,8" FontWeight="SemiBold" />
                                <ProgressBar x:Name="GenerateProgress" IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="AiStatus" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBox x:Name="AiPrompt" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" MinHeight="90"
                                     ToolTip="e.g. &quot;open YouTube in a new tab and turn the volume up a lot&quot; or &quot;show my desktop&quot;" />
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Style="{StaticResource VSplitter}" />

                    <!-- Suggestion preview -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                        <Grid>
                            <DockPanel x:Name="AiPreview" Visibility="Hidden">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="WHEN I SAY" Style="{StaticResource SectionLabel}" />
                                    <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,0,0,10" />
                                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                                        <TextBlock x:Name="AiExplanation" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="DO THESE STEPS, IN ORDER" Style="{StaticResource SectionLabel}" />
                                </StackPanel>

                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button Content="▶  Test" Click="AiTest_Click" Margin="0,0,6,6" />
                                    <Button Content="Discard" Click="AiDiscard_Click" Margin="0,0,6,6" />
                                    <Button Content="＋ Add to my commands" Click="AiAdd_Click" Style="{StaticResource AccentButton}"
                                            FontWeight="SemiBold" Padding="16,5" Margin="0,0,0,6" />
                                </WrapPanel>

                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepsPanel}"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" />
                            </DockPanel>

                            <StackPanel x:Name="AiEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="✨" FontSize="34" HorizontalAlignment="Center" />
                                <TextBlock Text="Describe it, review it, keep it" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,8" />
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}">
                                    The suggested command shows up here. Nothing runs until you press Test, and nothing is saved until you add it to your commands.
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- The other tabs live in their own files under Tabs\. -->
            <TabItem Header="Profiles">
                <tabs:ProfilesTab x:Name="ProfilesTabControl" />
            </TabItem>
            <TabItem Header="Schedules">
                <tabs:SchedulesTab x:Name="SchedulesTabControl" />
            </TabItem>
            <TabItem Header="History">
                <tabs:HistoryTab x:Name="HistoryTabControl" />
            </TabItem>
            <TabItem Header="Voice test">
                <tabs:VoiceTestTab x:Name="VoiceTestTabControl" />
            </TabItem>
            <TabItem Header="Settings">
                <tabs:SettingsTab x:Name="SettingsTabControl" />
            </TabItem>
            <TabItem Header="Help">
                <tabs:HelpTab x:Name="HelpTabControl" />
            </TabItem>
        </TabControl>

        <!-- ===== Back / forward through the commands and tabs you've viewed, like a browser ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="38">
            <Button x:Name="BackButton" Click="Back_Click" Width="34" Height="30" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0" IsEnabled="False"
                    ToolTip="Back: undo your last change, or go back to the last command you had open (Alt+Left)">
                <!-- Drawn chevrons: the ‹ › text characters sit below the middle of the button. -->
                <Path Data="M 6,0 L 0,6 L 6,12" Style="{StaticResource NavChevron}" />
            </Button>
            <Button x:Name="ForwardButton" Click="Forward_Click" Width="34" Height="30" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="False" ToolTip="Forward: redo, or go forward again (Alt+Right)">
                <Path Data="M 0,0 L 6,6 L 0,12" Style="{StaticResource NavChevron}" />
            </Button>
        </StackPanel>


        <GridSplitter Grid.Row="3" Style="{StaticResource HSplitter}" />

        <!-- ===== Activity log ===== -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" Style="{StaticResource SectionLabel}" />
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource MutedTextBrush}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
