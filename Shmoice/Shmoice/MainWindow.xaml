<Window x:Class="Shmoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:models="clr-namespace:Shmoice.Models"
        Title="Shmoice" Height="620" Width="960" MinHeight="450" MinWidth="720">
    <Window.Resources>
        <ObjectDataProvider x:Key="ActionTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ActionType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Listening controls -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ListenButton" Content="Start listening" Click="ListenButton_Click" FontWeight="SemiBold" />
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" Margin="4,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Not listening" VerticalAlignment="Center" Width="180" />
                <TextBlock Text="Wake word (optional):" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Text="{Binding Settings.WakeWord, UpdateSourceTrigger=PropertyChanged}" Width="110" VerticalAlignment="Center"
                         ToolTip="If set, say this before each command, e.g. &quot;computer volume up&quot;." />
                <TextBlock Text="Min confidence:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <Slider Value="{Binding Settings.ConfidenceThreshold}" Minimum="0.3" Maximum="0.95" Width="110"
                        VerticalAlignment="Center" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                <TextBlock Text="{Binding Settings.ConfidenceThreshold, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Activity log -->
        <GroupBox DockPanel.Dock="Bottom" Header="Activity" Height="130" Margin="0,8,0,0">
            <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas" />
        </GroupBox>

        <TabControl>
            <TabItem Header="Commands">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Command list -->
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="+ New" Click="AddCommand_Click" />
                            <Button Content="Delete" Click="DeleteCommand_Click" />
                        </StackPanel>
                        <ListBox x:Name="CommandList" ItemsSource="{Binding Commands}" SelectionChanged="CommandList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Phrase}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Command editor -->
                    <DockPanel Grid.Column="2" x:Name="Editor" DataContext="{Binding SelectedItem, ElementName=CommandList}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Say this:" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,4,0,10" />
                            <TextBlock Text="To do these steps, in order:" FontWeight="SemiBold" Margin="0,0,0,4" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom">
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="+ Step" Click="AddStep_Click" />
                                <Button Content="Remove step" Click="RemoveStep_Click" />
                                <Button Content="Move up" Click="MoveStepUp_Click" />
                                <Button Content="▶ Test now" Click="TestCommand_Click" Margin="18,0,6,0" />
                                <Button Content="Save" Click="Save_Click" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11">
                                Parameters — KeyCombo: keys joined by + (ctrl+shift+esc, alt+tab, win+d, f5) ·
                                TypeText: text to type · Open: program, file, folder or URL (add arguments after |) ·
                                Wait: milliseconds · Volume steps change volume by 2% each, so use Repeat.
                            </TextBlock>
                        </StackPanel>

                        <DataGrid x:Name="StepsGrid" ItemsSource="{Binding Steps}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Action" Width="150"
                                                        ItemsSource="{Binding Source={StaticResource ActionTypes}}"
                                                        SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Parameter" Width="*" Binding="{Binding Parameter, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Repeat" Width="70" Binding="{Binding Repeat, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="AI Builder (coming soon)">
                <TextBlock Margin="16" TextWrapping="Wrap" Foreground="#666">
                    Describe an action in plain words and an AI model will turn it into steps you can save as a command.
                    Commands are stored as simple JSON steps (Action + Parameter + Repeat), which is the format the model will output.
                </TextBlock>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
