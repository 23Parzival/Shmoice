<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version unlocks WinRT APIs (used for real Play/Pause media control). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Fluent ThemeMode is marked experimental in WPF; opt in. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- App info shown in the exe's Properties > Details and by the installer. -->
    <Version>1.3.0</Version>
    <Product>Shmoice</Product>
    <AssemblyTitle>Shmoice</AssemblyTitle>
    <Description>Voice commands for your PC</Description>
    <!-- Icon for the exe, taskbar, Start menu and shortcuts. Assets\Logo.png is the full-size source. -->
    <ApplicationIcon>Assets\Shmoice.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a WPF resource for the window title bars. -->
    <Resource Include="Assets\Shmoice.ico" />
    <!-- Shown on the splash screen at launch. -->
    <Resource Include="Assets\Logo.png" />
  </ItemGroup>

  <!-- Publish settings: one self-contained Shmoice.exe that runs without .NET installed.
       Used by `dotnet publish` (see publish.ps1); normal builds are unaffected.
       WPF doesn't support trimming, so it is left off. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

</Project>
